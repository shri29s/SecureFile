{
  "name": "securefile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.js",
    "chain": "hardhat node --hostname 127.0.0.1",
    "compile": "node scripts/compile.js",
    "deploy": "node scripts/deploy.js",
    "start": "node --env-file=.env proxy/src/server.js",
    "dev": "vite --config ui/vite.config.js --host 127.0.0.1",
    "build": "vite build --config ui/vite.config.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:integration": "node --env-file=.env --test test/integration.live.js",
    "health": "node --env-file=.env scripts/health.js",
    "bench": "node --env-file=.env bench/revocation.js",
    "bench:crypto": "node bench/crypto.js",
    "evaluation:report": "node scripts/evaluation-report.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "ethers": "^6.15.0",
    "express": "^5.1.0",
    "idb-keyval": "^6.2.2",
    "kubo-rpc-client": "^6.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "hardhat": "^2.26.3",
    "solc": "0.8.28",
    "tailwindcss": "^4.1.0",
    "vite": "^7.1.0"
  }
}
